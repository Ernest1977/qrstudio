# Copier en `.env` (dev) ou pousser dans /etc/qrstudio/env (prod). Aucune valeur ci-dessous n'est
# secrete : les jetons reelles ne doivent jamais atterrir dans le depot.
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=config.settings.dev
# En prod : generer par `python3 -c "from django.core.management.utils import get_random_secret_key as g; print(g())"`.
DJANGO_SECRET_KEY=change-me-50-characters-minimum
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=qrstudio.kamcofarm.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://qrstudio.kamcofarm.com
# URL de l'admin. En prod, laisser vide => une valeur aleatoire est tiree a chaque demarrage et il
# faut la lire dans les journaux (ou la figer ici pour eviter une surprise apres un redemarrage).
DJANGO_ADMIN_PATH=manage-9f2
DJANGO_ADMIN_REQUIRE_MFA=1

# Base de donnees. En prod, on pointe sur PgBouncer (port 6432), pas sur Postgres directement.
DATABASE_URL=postgres://qrs:qrs@127.0.0.1:5432/qrs
# Redis : cache de resolution des slugs + compteurs de frein + file des scans.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# S3/MinIO (logos, exports).
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_STORAGE_BUCKET_NAME=qrs-media
AWS_ACCESS_KEY_ID=qrs
AWS_SECRET_ACCESS_KEY=qrs-secret

# Hote public sert a composer les URL courtes imprimees sur les supports.
SHORT_BASE_URL=https://qrstudio.kamcofarm.com

# OAuth Google — abstraction demandee pour l'instant : laisser vide, le flux est ecrit mais
# inoffensif. Sans les deux cles (ou une SocialApp creee depuis l'admin), /auth/google/url repond 503
# et le bouton n'est pas rendu par le front. `GOOGLE_LOGIN_ENABLED=0` coupe l'allee sans effacer la
# configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_ENABLED=
# Fermer les inscriptions sans redemarrer (incident, capacite, migration en cours). Le front masque
# le formulaire d'apres /api/v1/auth/config, et la vue refuse quand meme le POST.
ALLOW_REGISTRATION=1
# Ne sert plus a rien tant que Google n'est pas cable : laisser a 1 pour ne pas casser le jour ou.
SOCIALACCOUNT_ALLOW_REGISTRATION=1

# Email. L'expéditeur doit etre autorise par SPF+DKIM du domaine, sinon les codes atterrissent en spam.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=QR Studio <itsupport@kamcofarm.com>
# Doit exister comme boite aux lettres ET etre couverte par le SPF/DKIM du domaine d'envoi.
# SERVER_EMAIL (erreurs Django, rapports de taches) herite de cette valeur si elle est vide.
SERVER_EMAIL=QR Studio <itsupport@kamcofarm.com>
# Verifiable par le front : un e-mail de test part vers cette adresse uniquement en dev.
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# RGPD. 1 = la ville est enregistree (opt-in client), 0 = pays seul (reglage par defaut).
GEOIP_CITY_ENABLED=0
MAXMIND_CITY_DB=/var/lib/geoip/GeoLite2-City.mmdb
# Duree de conservation des lignes brutes (mois) et des adresses IP tronquees (heures).
SCAN_RAW_RETENTION_MONTHS=13
SCAN_IP_RETENTION_HOURS=24

# ---- Facturation (Stripe) --------------------------------------------------
# Cle secrete **de test** (sk_test_...) ; la cle publiee (pk_test_...) va au front.
# Aucune des deux ne doit finir dans le bundle : le lien de paiement est cree par le backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id Stripe -> palier. Le recoupement est obligatoire : un price id inconnu n'accorde rien.
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_BUSINESS=price_...
# Les montants (2,99 / 8,99 / 15,99 EUR) vivent dans apps/accounts/plans.py, pas ici.
BILLING_CURRENCY=eur
BILLING_GRACE_DAYS=3

# ---- Paiement mobile (mobile-money / wallets) ------------------------------
# Fournisseur branche : `flutterwave` (MTN MoMo, Airtel Money, M-PESA, Orange Money) ou `demo`
# (fil de simulation, dev seulement — exige MOBILE_MONEY_ALLOW_DEMO=1). Vide = endpoints en 503
# `mobile_provider_non_configure` : l'instance dit qu'elle n'est pas reglee, elle n'invente pas un paiement.
# Le contrat d'adaptateur (et la liste des fournisseurs reconnus) vit dans apps/billing/mobile.py.
MOBILE_MONEY_PROVIDER=
MOBILE_MONEY_BASE_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_WEBHOOK_SECRET=
# --- Flutterwave : MTN MoMo / Airtel Money / M-PESA / Orange Money ---------------------------
# `MOBILE_MONEY_PROVIDER=flutterwave` active ce canal. La cle secrete (FLWSECK-...) et le secret hash
# des webhooks se recuperent dans le tableau de bord Flutterwave ; le 2e est obligatoire, sans lui
# aucun rappel ne sera jamais considere comme une preuve.
MOBILE_MONEY_FLUTTERWAVE_SECRET_KEY=
MOBILE_MONEY_FLUTTERWAVE_SECRET_HASH=
# Type de charge v3 : mobile_money_uganda | mpesa | mobile_money_tanzania | mobile_money_zambia |
# mobile_money_franco | mobile_money_kenya ... et le reseau/pays correspondants.
MOBILE_MONEY_FLUTTERWAVE_TYPE=mobile_money_uganda
MOBILE_MONEY_FLUTTERWAVE_RESEAU=MTN
MOBILE_MONEY_FLUTTERWAVE_PAYS=
# La grille est en euros : si le reseau facture une autre devise, il FAUT un taux, sinon l'adaptateur
# refuse la demande (503) au lieu d'envoyer un montant incomprehensible au reseau.
MOBILE_MONEY_FLUTTERWAVE_DEVISE=EUR
MOBILE_MONEY_FLUTTERWAVE_TAUX=
MOBILE_MONEY_FLUTTERWAVE_ARRONDI=0.01
MOBILE_MONEY_FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
MOBILE_MONEY_FLUTTERWAVE_TIMEOUT=12
# En staging Flutterwave, laissez le mode demo explicitement desactive.
# Le mode demo ne doit jamais tourner hors de la dev : sans ce drapeau, `demo` repond 503.
MOBILE_MONEY_ALLOW_DEMO=0
MOBILE_MONEY_MIN_AMOUNT_CENTS=100
MOBILE_MONEY_MAX_AMOUNT_CENTS=500000
MOBILE_MONEY_EXPIRE_MINUTES=30

# ------------------------------------------------------------------ politique de contenu (CSP)
# Trois etats : `off` (aucun en-tete), `report-only` (en-tete publie, rien n'est bloque, les violations
# sont journalisees), `apply` (la politique bloque). Laisse vide = `off` en debug et `report-only` sinon :
# on publie avant d'appliquer, on ne decouvre pas une page casseee en production.
CSP_MODE=
# Ou les navigateurs declarent leurs violations (vue `apps.common.csp.signaler_violation` : une ligne de
# journal par minute et par adresse). Mettez `0` si vous n'exploitez pas le journal : un rapport qu'on ne lit
# pas est du bruit, pas une securite.
CSP_SIGNALER=1
# Vanne d'echappement amont, documentee dans README (« Politique de contenu »). Si une montee de version
# d'`allauth` ou de `django.contrib.admin` introduit un vrai script en ligne, ajoutez-y le HASH du fichier
# (`'sha256-…'`) : n'y remettez jamais `'unsafe-inline'` — la presence d'un nonce le rendrait inutilement
# large pour les navigateurs modernes et silencieux pour les anciens.
CSP_SCRIPT_SRC_EXTRA=
